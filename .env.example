# Copy to .env and fill in only the channels you use. .env is git-ignored: never commit real secrets.

# Email alerts (Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Telegram alerts: create a bot with @BotFather and paste its token.
# Each contact presses Start on your bot once; get their numeric chat ID from @userinfobot.
TELEGRAM_BOT_TOKEN=
